{
  "name": "mysampark-mcp",
  "displayName": "MySampark MCP",
  "description": "Connect VS Code to your MySampark account — manage products and social media campaigns without leaving the editor.",
  "version": "1.0.0",
  "publisher": "mysampark",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "mysampark",
    "ecommerce",
    "social media"
  ],
  "homepage": "https://mysampark.com",
  "bugs": {
    "url": "https://github.com/utsav12322/socialpilot-clone/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mysamparkMcpProvider",
        "label": "MySampark"
      }
    ],
    "commands": [
      {
        "command": "mysampark-mcp.updateToken",
        "title": "MySampark: Update API Token"
      },
      {
        "command": "mysampark-mcp.signOut",
        "title": "MySampark: Sign Out (clear stored token)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check-types && npm run esbuild-base",
    "check-types": "tsc --noEmit -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run esbuild-base -- --watch"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.7.1",
    "typescript": "^5.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/utsav12322/mysampark-mcp-plugin",
    "directory": "vscode-extension"
  }
}
